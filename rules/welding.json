{
  "schema_version": "0.1",
  "work_type": "welding",
  "label": "용접·용단",
  "rules": [
    {
      "id": "V1",
      "title": "화재감시자",
      "hazard": "불티가 가연물에 옮겨붙어 화재로 번지고 대피가 늦어짐",
      "protections": [
        "화재감시자를 지정해 배치",
        "업무: 가연물 확인, 가스 검지·경보 장치 작동 확인, 대피 유도",
        "확성기·휴대용 조명기구·화재 대피용 마스크 지급",
        "감시·대피 유도 업무만 맡김(가이드)"
      ],
      "applies_when": { "any": [ { "combustibles_nearby": "yes" }, { "combustibles_below_or_behind": "yes" } ] },
      "exceptions": ["같은 장소 상시·반복 작업 + 경보·소화설비 또는 소화기 구비 시 생략 가능"],
      "level": { "when_applies": "required", "otherwise": "recommended", "when_unknown": "required" },
      "evidence": { "method": "partial_photo", "photo_items": ["fire_watcher_with_equipment"], "ask": true },
      "source": { "basis": "legal", "articles": ["산안규칙 제241조의2"], "status": "verified_via_guide" }
    },
    {
      "id": "V2",
      "title": "불티 비산방지·가연물 방호",
      "hazard": "1,600도 이상 불티가 높이·바람에 따라 11m를 넘어 최대 약 15m까지 날아감(가이드 예시)",
      "protections": [
        "성능인증 방화포(2026.3.2부터) 또는 불티관통 방지 성능 재료로 가연물 덮기",
        "가연물은 별도 보관하고 필요한 양만 두기",
        "벽·바닥·덕트의 개구부와 틈새 덮기"
      ],
      "applies_when": { "combustibles_present": "yes" },
      "range_up_when": [ { "work_height": "over_2m" }, { "location": "outdoor" } ],
      "exceptions": [],
      "level": { "when_applies": "required", "otherwise": "recommended", "when_unknown": "required" },
      "evidence": { "method": "photo", "photo_items": ["fire_blanket_installed"], "ask": false },
      "source": { "basis": "legal", "articles": ["산안규칙 제241조 제2항 4호", "산안규칙 제236조 제2항"], "secondary": ["건설현장 화재안전성능기준 NFPC 606"], "status": "verified_via_guide" }
    },
    {
      "id": "V3",
      "title": "소화기구 비치",
      "hazard": "초기 진화 수단이 없어 불씨가 커짐",
      "protections": [
        "작업 장소 가까이에 소화기구 비치",
        "소방 정리: 화재위험작업 시 소화기 2개 + 대형소화기 1개(현행 수량·거리는 원문 확인 필요)"
      ],
      "applies_when": { "combustibles_present": "yes" },
      "exceptions": [],
      "level": { "when_applies": "required", "otherwise": "recommended", "when_unknown": "required" },
      "evidence": { "method": "photo", "photo_items": ["extinguisher_present"], "ask": false },
      "source": { "basis": "legal", "articles": ["산안규칙 제241조 제2항 3호"], "secondary": ["소방시설법 시행령 임시소방시설 기준"], "status": "needs_check" }
    },
    {
      "id": "V4",
