      "exceptions": [],
      "level": { "when_applies": "required", "otherwise": "recommended", "when_unknown": "required" },
      "evidence": { "method": "supervisor", "photo_items": [], "ask": true },
      "source": { "basis": "legal+guideline", "articles": ["산안규칙 제241조 제1항", "산안규칙 제241조 제2항 5호", "산안규칙 제232조", "산안규칙 제239조"], "guideline": ["KOSHA GUIDE A-G-14-2026 6.1(6)"], "status": "needs_check" },
      "design_note": "동시작업 금지는 가이드(권고)지만 사고 사례(2020 이천, 2025 반얀트리)를 근거로 필수로 안내"
    },
    {
