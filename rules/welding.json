      "title": "작업 후 화재 감시",
      "hazard": "단열재·보온재에 파고든 불티가 시간이 지나 다시 불붙음",
      "protections": [
        "작업 종료 후 적어도 30분 화재 감시(가이드)",
        "주변 불티·틈새 확인, 토치·호스 정리, 가스 밸브 잠금"
      ],
      "applies_when": { "always": true },
      "exceptions": [],
      "level": { "when_applies": "recommended", "otherwise": "recommended", "when_unknown": "recommended" },
      "evidence": { "method": "supervisor", "photo_items": [], "ask": true, "timer_minutes": 30 },
      "source": { "basis": "guideline", "articles": ["KOSHA 화재감시자 참고자료(작업 후 30분 권고)"], "status": "verified_official" },
      "design_note": "법정 의무로 단정하지 않음. 지역 소방서 안내는 1시간 이상도 있음"
    },
    {
      "id": "V6",
      "title": "작업 준비·교육·작업 전 확인·서면 게시",
      "hazard": "절차·교육 없이 작업해 비상 대응에 실패",
      "protections": [
        "작업 준비·절차 수립, 위험물 현황 파악",
        "근로자 화재예방·피난교육",
        "작업 시작 전 확인과 안전조치 이행",
        "작업내용·일시·안전점검·조치사항 서면 게시"
      ],
      "applies_when": { "combustibles_present": "yes" },
      "exceptions": ["같은 장소 상시·반복 작업은 서면 게시 생략 가능"],
      "level": { "when_applies": "required", "otherwise": "recommended", "when_unknown": "required" },
      "evidence": { "method": "partial_photo", "photo_items": ["posting_visible"], "ask": true },
      "source": { "basis": "legal", "articles": ["산안규칙 제241조 제2항 1·2·6호", "산안규칙 제241조 제3항", "산안규칙 제241조 제4항"], "status": "verified_via_guide" }
    }
