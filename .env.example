# mock은 기본값이며 네트워크를 사용하지 않음 | openai
BANJANG_LLM=mock
# 사진 판정만 실제 OpenAI 비전 모델로 보내려면 openai로 설정 (외부 API 비용 발생)
BANJANG_VISION=mock
OPENAI_API_KEY=
# 조건 추출: 텍스트만, 싼 모델
BANJANG_MODEL_EXTRACT=
# 사진 판정·검증: 비전 성능 좋은 모델
BANJANG_MODEL_JUDGE=
# Browser-recorded speech is transcribed with the real OpenAI audio endpoint.
BANJANG_TRANSCRIPTION_MODEL=gpt-transcribe
# BANJANG_PROMPTS=prompts/v0
# BANJANG_PRICES=config/model_prices.json
# 모델 이름은 OpenAI 공식 모델 목록에서 확인해서 넣는다(코드에 기본값 없음).
# .env는 git 제외. 실제 API 호출은 사람 승인 후에만 한다.
